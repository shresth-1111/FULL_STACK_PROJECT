<% if(success && success.length>0){ %>
    <div class="alert alert-success alert-dismissible fade show cols-6 offest-3" role="alert">
        <%=success%>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
<%}%>

<% if(failure && failure.length>0){ %>
    <div class="alert alert-danger alert-dismissible fade show cols-6 offest-3" role="alert">
        <%=failure%>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
<%}%>