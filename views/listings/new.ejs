<% layout("/layouts/boilerplate")%>
<body>
    <div class="row">
        <div class="col-8 offset-2">
            <br/>
            <h3><u>CREATE A NEW LISTING</u></h3>
            <br/>
            <form method="POST" action="/listings" class="needs-validation" novalidate enctype="multipart/form-data">
                <div>
                    <label for="Title" class="form-label">Title</label>
                    <input name="listing[title]" placeholder="enter title" type="text" class="form-control" required>
                    <div class="invalid-feedback">
                        Please enter a valid title.
                    </div>
                    <div class="valid-feedback">
                        Looks good!
                    </div>
                    <br/>
                </div>
                <div>
                    <br/>
                    <label for="description" class="form-label">Description</label>
                    <textarea name="listing[description]" placeholder="enter description" type="text" class="form-control" required></textarea>
                    <div class="invalid-feedback">
                        Please enter a valid description.
                    </div>
                    <div class="valid-feedback">
                        Looks good!
                    </div>
                    <br/>
                </div>
                <div>
                    <br/>
                    <label for="image" class="form-label">Upload Listing Image</label>
                    <input name="listing[image]" type="file" class="form-control" required>
                    <br/>
                </div>
                <div>
                    <br/>
                    <label for="price" class="form-label">Price</label>
                    <input name="listing[price]" placeholder="enter price" type="number" class="form-control" required>
                    <div class="invalid-feedback">
                        Please enter a valid price.
                    </div>
                    <div class="valid-feedback">
                        Looks good!
                    </div>
                    <br/>
                </div>
                <div class="row">
                    <div class="col-md-4">
                        <div>
                            <br/>
                            <label for="location" class="form-label">Location</label>
                            <input name="listing[location]" placeholder="enter location" type="text" class="form-control" required>
                            <div class="invalid-feedback">
                                Please enter a valid loaction.
                            </div>
                            <div class="valid-feedback">
                                Looks good!
                            </div>
                            <br/>
                        </div>
                    </div>
                    <div class="col-md-8">
                        <div>
                            <br/>
                            <label for="country" class="form-label">Country</label>
                            <input name="listing[country]" placeholder="enter country" type="text" class="form-control" required>
                            <div class="invalid-feedback">
                                Please enter a valid country.
                            </div>
                            <div class="valid-feedback">
                                Looks good!
                            </div>
                            <br/>
                        </div>
                    </div>
                </div>
                <br/>
                <button class="btn btn-dark add-btn">Submit</button>
            </form>
            <br/>
        </div>
    </div>
</body>